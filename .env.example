# ─────────────────────────────────────────────────────────────
# Configuración de Coop AI Workflow — copiar a .env.local
# NUNCA subir el archivo .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# Proveedor de LLM: "local" | "anthropic" | "openai"
LLM_PROVIDER=local

# ── Modo local (Ollama / LM Studio, API compatible OpenAI) ──
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder

# ── Modo API keys (producción / Vercel) ─────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Modelo por agente (opcional; por defecto usa el del proveedor)
# ORCHESTRATOR_MODEL=
# DEVELOP_MODEL=
# TESTING_MODEL=

# ── Base de datos (plan gratuito: Neon / Supabase / Turso) ──
# DATABASE_URL=
