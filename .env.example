# ─────────────────────────────────────────────────────────────
# Configuración de Coop AI Workflow — copiar a .env.local
# NUNCA subir el archivo .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# Modo del servicio de IA: "auto" (detecta solo), "local" o "api"
#  - auto : intenta Ollama local; si no responde, usa la API externa
#  - local: fuerza Ollama local (avisa si no responde, sin fallback)
#  - api  : fuerza la API externa (avisa si falta la key)
LLM_MODE=auto

# ── Modo local (Ollama) ─────────────────────────────────────
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5-coder

# ── Modo API externa (compatible con OpenAI) ────────────────
# Vale para DeepSeek, Kimi/Moonshot, OpenAI, OpenRouter…
# solo cambian URL, modelo y key. Ejemplos de URL:
#   https://api.deepseek.com/v1
#   https://api.moonshot.cn/v1
#   https://api.openai.com/v1
# LLM_API_BASE_URL=
# LLM_API_MODEL=
# LLM_API_KEY=

# Modelo por agente (opcional; por defecto el del proveedor activo)
# ORCHESTRATOR_MODEL=
# DEVELOP_MODEL=
# TESTING_MODEL=

# ── Base de datos (plan gratuito: Neon / Supabase / Turso) ──
# DATABASE_URL=
