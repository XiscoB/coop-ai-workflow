# ─────────────────────────────────────────────────────────────
# Configuración de Coop AI Workflow — copiar a .env.local
# NUNCA subir el archivo .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# Modo del servicio de IA: "auto" (detecta solo), "local" o "api"
#  - auto : intenta Ollama local; si no responde, usa la API externa
#  - local: fuerza Ollama local (avisa si no responde, sin fallback)
#  - api  : fuerza la API externa (avisa si falta la key)
LLM_MODE=auto

# ── Modo local (Ollama) ─────────────────────────────────────
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5-coder

# ── Modo API externa (compatible con OpenAI) ────────────────
# Vale para cualquier API compatible con OpenAI: solo cambian
# URL, modelo y key. Tiers gratuitos documentados en
# docs/proveedores-ia-gratuitos.md. Ejemplos de URL:
#   https://api.groq.com/openai/v1            (Groq, ~1.000 req/día gratis)
#   https://generativelanguage.googleapis.com/v1beta/openai/  (Google AI Studio)
#   https://openrouter.ai/api/v1              (modelos :free)
#   https://api.deepseek.com/v1
#   https://api.moonshot.cn/v1
#   https://api.openai.com/v1
# LLM_API_BASE_URL=
# LLM_API_MODEL=
# LLM_API_KEY=

# Modelo por agente (opcional; por defecto el del proveedor activo)
# ORCHESTRATOR_MODEL=
# DEVELOP_MODEL=
# TESTING_MODEL=

# "Modo lento": pausa mínima en segundos entre llamadas a la API externa.
# Útil en tiers gratuitos con límite de tokens/minuto (p. ej. 20).
# Además, tras un 429 la app pisa el freno sola automáticamente.
# LLM_MIN_INTERVAL_SECONDS=

# ── Base de datos (plan gratuito: Neon Postgres) ────────────
# DATABASE_URL=

# ── Acceso a la app (credencial compartida de prueba) ───────
# Usuario/contraseña del login y secreto para firmar la cookie
# de sesión (genera uno largo y aleatorio).
# APP_USER=
# APP_PASSWORD=
# AUTH_SECRET=
